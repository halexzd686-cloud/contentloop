# Supabase PostgreSQL connection string
# Format: postgresql://postgres:[password]@[host]:[port]/postgres
# Get from: Supabase Dashboard → Project Settings → Database → Connection String → URI
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Direct connection (for migrations, if using Supabase pooler for DATABASE_URL)
# DIRECT_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# AI Provider (DeepSeek official API, OpenAI-compatible)
# Get from: https://platform.deepseek.com → API Keys
AI_API_KEY=your-deepseek-api-key
# AI_MODEL=deepseek-v4-flash
# AI_BASE_URL=https://api.deepseek.com
