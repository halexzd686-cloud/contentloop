# PostgreSQL connection string (required, server-only)
# ContentLoop V1 uses Supabase as managed PostgreSQL (no Supabase Auth/Realtime/Storage).
# Supabase: Dashboard → Project Settings → Database → Connection String → URI
# The same URL is used for runtime and migrations (postgres.js runs with prepare:false,
# so the Supabase pooler URI works for both).
DATABASE_URL=postgresql://postgres:your-password@your-project.pooler.supabase.com:5432/postgres

# AI provider (optional, server-only) — DeepSeek official API, OpenAI-compatible.
# Without a key, every AI feature degrades to the manual workflow.
# Get from: https://platform.deepseek.com → API Keys
AI_API_KEY=your-deepseek-api-key

# Optional overrides (defaults shown; the code default is used when unset)
# AI_MODEL=deepseek-v4-flash
# AI_BASE_URL=https://api.deepseek.com
